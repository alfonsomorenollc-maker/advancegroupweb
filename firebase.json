{
  "hosting": {
    "site": "advancegroup-web-4391643-961a3",
    "predeploy": [
      "npm run build",
      "cp dist/index.html functions/index.template.html"
    ],
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/empleos",
        "function": {
          "functionId": "ogEmpleos",
          "region": "us-central1"
        }
      },
      {
        "source": "/empleos/**",
        "function": {
          "functionId": "ogEmpleos",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "web",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "*.log"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" ci --no-audit --no-fund",
        "cp dist/index.html functions/index.template.html"
      ]
    }
  ],
  "emulators": {
    "hosting": {
      "port": 5000,
      "host": "127.0.0.1"
    },
    "functions": {
      "port": 5001,
      "host": "127.0.0.1"
    },
    "hub": {
      "port": 4410,
      "host": "127.0.0.1"
    },
    "logging": {
      "port": 4510,
      "host": "127.0.0.1"
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
